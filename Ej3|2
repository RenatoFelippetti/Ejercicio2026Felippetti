#include <stdio.h>
 
int main() {
    int carta;
 
    printf("Ingrese el numero de la carta: ");
    scanf("%d", &carta);
 
    switch (carta) {
        case 1:
            printf("As\n");
            break;
        case 10:
            printf("Sota\n");
            break;
        case 11:
            printf("Caballo\n");
            break;
        case 12:
            printf("Rey\n");
            break;
        case 2: case 3: case 4: case 5:
        case 6: case 7: case 8: case 9:
            printf("No es as ni figura\n");
            break;
        default:
            printf("este no es un número de una carta de la baraja española\n");
            break;
    }
 
    return 0;
}
