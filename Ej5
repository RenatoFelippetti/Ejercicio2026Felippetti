#include <stdio.h>
 
int main() {
    int i, n, suma = 0;
 
    for (i = 1; i <= 5; i++) {
        do {
            printf("Ingrese el numero natural %d: ", i);
            scanf("%d", &n);
            if (n < 1) {
                printf("Debe ser un numero natural (1, 2, 3...).\n");
            }
        } while (n < 1);
 
        suma = suma + n;
    }
 
    printf("La suma de los 5 numeros es: %d\n", suma);
 
    return 0;
}
